<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ Raíz: DEMO Impuestos bajo Contabilidad ══════════════════════════
         Corregido 2026-07-28: antes usaba parent_id eval="562" (ID crudo de
         BD) — funcionaba en QA/PROD porque ahí coincide con "Accounting"
         (accountant.menu_accounting, módulo ENTERPRISE), pero el manifest
         de este módulo declara depends solo de account/mail/iap ("sin
         Enterprise") — en cualquier base Community (ej. el piloto nuevo del
         despacho), ese ID no existe y la instalación falla con FK violation
         en ir_ui_menu. account.menu_finance ("Invoicing") es el menú raíz
         del módulo base `account`, existe siempre, con o sin Enterprise. -->
    <record id="ve_retencion_menu_root" model="ir.ui.menu">
        <field name="name">DEMO Impuestos</field>
        <field name="parent_id" ref="account.menu_finance"/>
        <field name="sequence" eval="99"/>
        <field name="active" eval="True"/>
    </record>


    <!-- ══ 0. Dashboard IVA (Operativo + Gerencial) ═══════════════════════════ -->
    <menuitem id="DJCS_menu_dashboard_iva_operativo"
              name="Dashboard IVA — Operativo"
              parent="ve_retencion_menu_root"
              action="action_open_dashboard_iva_operativo"
              sequence="1"/>

    <menuitem id="DJCS_menu_dashboard_iva_gerencial"
              name="Dashboard IVA — Gerencial"
              parent="ve_retencion_menu_root"
              action="action_open_dashboard_iva_gerencial"
              sequence="2"/>

    <!-- Tendencias IVA se fusionó dentro de Dashboard IVA (sparklines en las
         tarjetas KPI); el modelo ve.dashboard.iva.trend se eliminó por
         completo, la lógica vive ahora en ve.dashboard.iva. -->

    <!-- ══ 1. IVA Clientes ══════════════════════════════════════════════════ -->
    <menuitem id="DJCS_menu_iva_clientes"
              name="IVA Clientes"
              parent="ve_retencion_menu_root"
              sequence="10"/>

    <!-- ══ 5. Utilitarios (definido aquí para que sus hijos puedan referenciarlo) ═ -->
    <menuitem id="DJCS_menu_otros"
              name="Utilitarios"
              parent="ve_retencion_menu_root"
              sequence="99"/>

    <menuitem id="DJCS_menu_iva_clientes_libro_ventas"
              name="Libro de Ventas"
              parent="DJCS_menu_iva_clientes"
              action="ve_action_wizard_libro_ventas"
              sequence="10"
              groups="ve_retencion_iva.group_ret_iva_gestor,account.group_account_manager"/>

    <menuitem id="DJCS_menu_iva_clientes_inbox"
              name="Buz&#xF3;n de Comprobantes"
              parent="DJCS_menu_otros"
              action="ve_comprobante_inbox_action"
              sequence="10"/>

    <menuitem id="DJCS_menu_conecta_carga_ventas"
              name="Cargar Libro de Ventas (Conecta)"
              parent="DJCS_menu_otros"
              action="ve_conecta_carga_ventas_action"
              sequence="15"
              groups="ve_retencion_iva.group_ret_iva_gestor,account.group_account_manager"/>

    <menuitem id="DJCS_menu_conecta_carga_compras"
              name="Cargar Libro de Compras (Conecta)"
              parent="DJCS_menu_otros"
              action="ve_conecta_carga_compras_action"
              sequence="16"
              groups="ve_retencion_iva.group_ret_iva_gestor,account.group_account_manager"/>

    <menuitem id="DJCS_menu_declarado_mensual"
              name="Cargar Declarado SENIAT"
              parent="DJCS_menu_otros"
              action="wizard_declarado_mensual_action"
              sequence="18"
              groups="ve_retencion_iva.group_ret_iva_gestor,account.group_account_manager"/>

    <menuitem id="DJCS_menu_iva_clientes_retenciones"
              name="Retenciones IVA Clientes"
              parent="DJCS_menu_iva_clientes"
              action="ve_wh_iva_action"
              sequence="30"/>

    <menuitem id="DJCS_menu_iva_clientes_zona"
              name="Retenciones por Zona"
              parent="DJCS_menu_iva_clientes"
              action="ve_wh_iva_action_zona"
              sequence="35"/>

    <menuitem id="DJCS_menu_iva_clientes_seniat"
              name="Retenciones SENIAT"
              parent="DJCS_menu_iva_clientes"
              action="ve_seniat_retencion_action"
              sequence="40"/>

    <menuitem id="DJCS_menu_iva_clientes_seniat_periodo"
              name="Retenciones SENIAT por Per&#xED;odo"
              parent="DJCS_menu_iva_clientes"
              action="ve_conciliacion_seniat_action"
