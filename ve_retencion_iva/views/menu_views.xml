    <menuitem id="DJCS_menu_iva_clientes_conciliacion"
              name="Conciliaci&#xF3;n SENIAT"
              parent="DJCS_menu_iva_clientes"
              action="ve_conciliacion_action"
              sequence="50"/>

    <menuitem id="DJCS_menu_iva_clientes_concil_visual"
              name="Visual IVA Clientes"
              parent="DJCS_menu_iva_clientes"
              action="ve_wh_iva_action_concil"
              sequence="60"/>

    <!-- Independiente del Dashboard IVA por ahora (ver REPOSICIONAMIENTO_MI_ERP.md /
         SMARTIVA_FUNCIONALIDADES_POST_MI_ERP.md) — candidato a integrarse como
         bloque del Dashboard una vez validado con la usuaria. -->
    <menuitem id="DJCS_menu_iva_clientes_cobranza"
              name="Cobranza vs. Comprobante"
              parent="DJCS_menu_iva_clientes"
              action="ve_wh_iva_action_cobranza"
              sequence="65"/>

    <record id="DJCS_action_reiniciar_demo" model="ir.actions.act_window">
        <field name="name">Reiniciar Data Demo</field>
        <field name="res_model">ve.reset.demo.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="DJCS_menu_iva_clientes_config"
              name="Configuraci&#xF3;n IVA"
              parent="DJCS_menu_otros"
              action="DJCS_action_ve_config_iva"
              sequence="20"
              groups="base.group_system,ve_retencion_iva.group_ret_iva_demo"/>

    <menuitem id="DJCS_menu_iva_clientes_demo"
              name="Reiniciar Demo"
              parent="DJCS_menu_otros"
              action="DJCS_action_reiniciar_demo"
              sequence="30"
              groups="base.group_system,ve_retencion_iva.group_ret_iva_demo"/>

    <menuitem id="DJCS_menu_setup_compania"
              name="Configuraci&#xF3;n Inicial — Compa&#xF1;&#xED;a Nueva"
              parent="DJCS_menu_otros"
              action="ve_wizard_setup_compania_action"
              sequence="25"
              groups="base.group_system"/>

    <menuitem id="DJCS_menu_iva_clientes_piloto"
              name="Reiniciar Período Demo — Piloto Conecta"
              parent="DJCS_menu_otros"
              action="ve_reset_piloto_wizard_action"
              sequence="35"
              groups="base.group_system,ve_retencion_iva.group_ret_iva_demo"/>

    <!-- ══ 2. IVA Proveedores ══════════════════════════════════════════════ -->
    <menuitem id="DJCS_menu_iva_proveedores"
              name="IVA Proveedores"
              parent="ve_retencion_menu_root"
              sequence="20"/>

    <menuitem id="DJCS_menu_iva_proveedores_libro_compras"
              name="Libro de Compras"
              parent="DJCS_menu_iva_proveedores"
              action="ve_action_wizard_libro_compras"
              sequence="5"
              groups="ve_retencion_iva.group_ret_iva_gestor,account.group_account_manager"/>

    <menuitem id="DJCS_menu_iva_proveedores_retenciones"
              name="Retenciones IVA Proveedores"
              parent="DJCS_menu_iva_proveedores"
              action="ve_wh_iva_prov_action"
              sequence="10"
              groups="ve_retencion_iva.group_ret_iva_gestor,account.group_account_manager"/>

    <menuitem id="DJCS_menu_iva_proveedores_declaracion"
