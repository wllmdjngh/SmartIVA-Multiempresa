              groups="ve_retencion_iva.group_ret_iva_gestor,account.group_account_manager"/>

    <!-- ══ 3. Declaración IVA ═══════════════════════════════════════════════ -->
    <menuitem id="DJCS_menu_declaracion_iva"
              name="Declaraci&#xF3;n IVA"
              parent="ve_retencion_menu_root"
              action="ve_declaracion_iva_action"
              sequence="30"/>

    <!-- ══ 4. Sanciones IVA ══════════════════════════════════════════════════ -->
    <menuitem id="DJCS_menu_sanciones_iva"
