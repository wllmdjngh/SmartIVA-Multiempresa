    <menuitem id="DJCS_menu_sanciones_iva_estimador"
              name="Estimar Riesgo SENIAT"
              parent="DJCS_menu_sanciones_iva"
              action="ve_action_estimacion_riesgo"
              sequence="20"
              groups="ve_retencion_iva.group_ret_iva_gestor,account.group_account_manager"/>

</odoo>
