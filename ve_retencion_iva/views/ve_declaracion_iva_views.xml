<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ Lista ═══════════════════════════════════════════════════════════════ -->
    <record id="ve_declaracion_iva_view_list" model="ir.ui.view">
        <field name="name">ve.declaracion.iva.list</field>
        <field name="model">ve.declaracion.iva</field>
        <field name="arch" type="xml">
            <list string="Declaraciones IVA" default_order="periodo_retencion desc">
                <field name="company_id"          string="Compañía" optional="show"
                       groups="base.group_multi_company"/>
                <field name="periodo_retencion"   string="Período"/>
                <field name="fecha_inicio"        string="Inicio"/>
                <field name="fecha_fin"           string="Fin"/>
                <field name="campo_49"            string="C.49 Déb. Fiscal"  sum="Total" optional="show"/>
                <field name="campo_39"            string="Total Créd. Fiscales" sum="Total" optional="show"/>
                <field name="campo_54_arrastre"    string="C.54 Arrastre"     sum="Total" optional="show"/>
                <field name="campo_66"            string="C.66 Retenciones"  sum="Total" optional="show"/>
                <field name="campo_90"            string="C.90 IVA a Pagar"  sum="Total" optional="show"/>
                <field name="total_retenido_prov" string="Ret. Prov."        sum="Total" optional="show"/>
                <field name="estado_conciliacion_periodo" widget="badge" string="Concilia IVA Cli"
                       decoration-success="estado_conciliacion_periodo in ('aprobado', 'declarado')"
                       decoration-info="estado_conciliacion_periodo in ('en_proceso', 'revision')"
                       decoration-warning="estado_conciliacion_periodo == 'borrador'"/>
                <field name="estado_prov" widget="badge" string="Declr IVA Prov."
                       decoration-success="estado_prov == 'declarado'"
                       decoration-warning="estado_prov == 'pendiente'"/>
                <field name="vencida"             column_invisible="1"/>
                <field name="estado" widget="badge" string="Declr IVA"
                       decoration-success="estado == 'presentada'"
                       decoration-info="estado == 'sustitutiva'"
                       decoration-danger="vencida"
                       decoration-warning="estado == 'borrador' and not vencida"/>
                <field name="nro_declaracion"     string="N° Certificado SENIAT"/>
                <field name="fecha_declaracion"   string="Fecha Declaración"/>
            </list>
        </field>
    </record>

    <!-- ══ Formulario ══════════════════════════════════════════════════════════ -->
    <record id="ve_declaracion_iva_view_form" model="ir.ui.view">
        <field name="name">ve.declaracion.iva.form</field>
        <field name="model">ve.declaracion.iva</field>
        <field name="arch" type="xml">
            <form string="Declaración IVA Venezuela">
                <header>
                    <!-- Forma 30 -->
                    <button name="action_reporte_seniat"
                            string="Forma 030 PDF"
                            type="object"
                            class="btn-secondary"
                            icon="fa-file-pdf-o"/>
                    <button name="action_abrir_wizard_declarar"
                            string="Declarar Forma 030"
                            type="object"
                            class="btn-primary"
                            invisible="estado == 'presentada'"/>
                    <button name="action_declarar_rpa"
                            string="Declarar por RPA"
                            type="object"
                            class="btn-secondary"
                            icon="fa-android"
                            confirm="Una vez declarado, las retenciones de este período quedarán bloqueadas y no podrán modificarse (montos, RIF, N° de Control, etc.). ¿Confirmar declaración por RPA?"
                            invisible="estado == 'presentada'"/>
                    <field name="estado" widget="statusbar"
                           statusbar_visible="borrador,presentada"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="periodo_retencion" string="Período"/>
                        <h1><field name="periodo_retencion" readonly="1"/></h1>
                        <field name="name" readonly="1" class="text-muted"/>
                    </div>

                    <!-- Alertas operativas -->
                    <div class="alert alert-warning" role="alert"
                         invisible="not alerta_vencidos or estado == 'presentada'">
                        <i class="fa fa-exclamation-triangle" title="Advertencia"/>&#160;
                        <field name="alerta_vencidos" readonly="1"/>
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="not alerta_esperados or estado == 'presentada'">
                        <i class="fa fa-clock-o" title="Pendiente"/>&#160;
                        <field name="alerta_esperados" readonly="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="estado_prov == 'declarado' or count_wh_iva_prov == 0">
                        <i class="fa fa-exclamation-circle" title="Alerta"/>&#160;
                        Hay <strong><field name="count_wh_iva_prov" readonly="1" nolabel="1"/></strong>
                        comprobante(s) de retención a proveedores pendientes de declarar al SENIAT.
                        Declare IVA Proveedores antes de declarar la Forma 030.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="estado != 'presentada' or planilla_declaracion_prov_nombre">
                        <i class="fa fa-exclamation-triangle" title="Advertencia"/>&#160;
                        <strong>IVA Proveedores declarado sin planilla adjunta</strong> —
                        Recuerde subir el PDF de la Planilla de Pago SENIAT.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="estado != 'presentada' or planilla_declaracion_nombre">
                        <i class="fa fa-exclamation-triangle" title="Advertencia"/>&#160;
                        <strong>Forma 030 declarada sin planilla adjunta</strong> —
                        Recuerde subir el PDF de la Planilla de Declaración SENIAT.
                    </div>

                    <group>
                        <group string="Período">
                            <field name="conciliacion_id" readonly="1"/>
                            <field name="fecha_inicio"    readonly="1"/>
                            <field name="fecha_fin"       readonly="1"/>
                        </group>
                        <group string="Período Activo">
                            <field name="fecha_inicio" readonly="1"/>
                            <field name="fecha_fin"    readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- ── Tab 0: Visual IVA Clientes (agentes SPE que nos retienen) ── -->
                        <page string="Visual IVA Clientes" name="clientes">
                            <field name="wh_iva_clientes_ids" mode="list"
                                   readonly="estado == 'presentada'">
                                <list string="Visual IVA Clientes" create="0" delete="0" editable="bottom"
                                      decoration-muted="estado_recepcion == 'esperado'"
                                      decoration-warning="estado_recepcion in ('vencido', 'recibido_dif', 'confirmado_dif')"
                                      decoration-success="estado_recepcion == 'confirmado'"
                                      decoration-info="estado_recepcion == 'recibido'">
                                    <field name="partner_id"          string="Cliente"        readonly="1"/>
                                    <field name="ref"                 string="Referencia"     readonly="1" optional="hide"/>
                                    <field name="rif"                 string="RIF"            readonly="1" optional="show"/>
                                    <field name="fecha"               string="Fecha Rec."     readonly="1" optional="show"/>
                                    <field name="name"                string="N° Comprobante" readonly="1"/>
                                    <field name="monto_retenido"      string="Esperado"       sum="Total Esperado" readonly="1"/>
                                    <field name="monto_recibido"      string="Recibido"       sum="Total Recibido" readonly="1" optional="show"/>
                                    <field name="monto_seniat"        string="SENIAT"         sum="Total SENIAT"   readonly="1" optional="show"/>
                                    <field name="incluir_declaracion" string="C.66"
                                           readonly="estado_declaracion == 'declarado'"/>
                                    <field name="monto_c66"           string="Monto C.66"     sum="Total C.66" readonly="1" optional="show"/>
                                    <field name="estado_recepcion" string="Recepci&#xf3;n" widget="badge"
                                           decoration-muted="estado_recepcion == 'esperado'"
                                           decoration-info="estado_recepcion in ('recibido', 'recibido_dif')"
                                           decoration-success="estado_recepcion in ('confirmado', 'confirmado_dif')"
                                           decoration-warning="estado_recepcion == 'vencido'"
                                           decoration-danger="estado_recepcion == 'anulado'"/>
                                    <field name="estado_conciliacion" string="Conciliaci&#xf3;n SENIAT" widget="badge"
                                           decoration-muted="estado_conciliacion in ('pendiente', 'solo_odoo', 'solo_seniat')"
                                           decoration-warning="estado_conciliacion == 'diferencia'"
                                           decoration-primary="estado_conciliacion == 'conciliada_norec'"
                                           decoration-success="estado_conciliacion in ('listo_declarar', 'conciliada', 'declarado', 'aprobado_declarar')"/>
                                    <field name="estado_declaracion" string="Declaraci&#xf3;n" widget="badge"
                                           decoration-muted="estado_declaracion == 'no_declarado'"
                                           decoration-success="estado_declaracion == 'declarado'"/>
                                    <button name="action_abrir_form"
                                            string="Abrir" type="object" icon="fa-external-link"
                                            class="btn-sm btn-link" title="Abrir comprobante"/>
                                    <button name="action_abrir_registrar_llamada"
                                            type="object" icon="fa-phone"
                                            class="btn-sm btn-outline-primary"
                                            title="Registrar llamada al contacto"/>
                                    <button name="action_recordatorio_envio_comp"
                                            type="object" icon="fa-envelope"
                                            class="btn-sm btn-secondary"
                                            title="Pedir envío del comprobante"
                                            invisible="not necesita_envio_comp"/>
                                    <button name="action_recordatorio_dif_seniat"
                                            type="object" icon="fa-exclamation-triangle"
                                            class="btn-sm btn-warning"
                                            title="Aclarar diferencia de monto con SENIAT"
                                            invisible="not necesita_aclarar_dif_seniat"/>
                                    <button name="action_recordatorio_rep_seniat"
                                            type="object" icon="fa-flag"
                                            class="btn-sm btn-danger"
                                            title="El agente debe reportar la retención a SENIAT"
                                            invisible="not necesita_reportar_seniat"/>
                                </list>
                            </field>
                        </page>

                        <!-- ── Tab 1: Retenciones Proveedores ── -->
                        <page string="IVA Proveedores" name="proveedores">
                            <field name="wh_iva_prov_ids" mode="list"
                                   context="{'default_declaracion_iva_id': id}">
                                <list string="Comprobantes Proveedores" create="0" delete="0">
                                    <field name="name"                 string="N° Comprobante"  readonly="1"/>
                                    <field name="ref"                  string="Ref. Interna"    readonly="1" optional="hide"/>
                                    <field name="state"                string="Estado" widget="badge" readonly="1"
                                           decoration-success="state == 'declarado'"
                                           decoration-info="state == 'enviado'"
                                           decoration-muted="state == 'anulado'"/>
                                    <field name="fecha"                string="Fecha"           readonly="1"/>
                                    <field name="partner_id"           string="Proveedor"       readonly="1"/>
                                    <field name="rif"                  string="RIF"             readonly="1" optional="show"/>
                                    <field name="invoice_name"         string="Factura"         readonly="1" optional="show"/>
                                    <field name="nro_control"          string="N° Control"      readonly="1"/>
                                    <field name="monto_base_16"        string="Base 16%"        sum="Total" readonly="1"/>
                                    <field name="monto_iva_16"         string="IVA 16%"         sum="Total" readonly="1"/>
                                    <field name="monto_base_8"         string="Base 8%"         sum="Total" readonly="1" optional="show"/>
                                    <field name="monto_iva_8"          string="IVA 8%"          sum="Total" readonly="1" optional="show"/>
                                    <field name="monto_iva_total"      string="IVA Total"       sum="Total" readonly="1"/>
                                    <field name="porcentaje_retencion" string="%"               readonly="1" optional="show"/>
                                    <field name="monto_retenido"       string="Retenido"        sum="Total" readonly="1"/>
                                    <button name="action_abrir_form"
                                            string="Abrir" type="object" icon="fa-external-link"
                                            class="btn-sm btn-link"/>
                                </list>
                            </field>
                        </page>

                        <!-- ── Tab 2: Forma 30 ── -->
                        <page string="Forma 030" name="forma30">
                            <group>
                                <group string="Débitos Fiscales (Ventas)">
                                    <field name="campo_40_base"    string="C.40  Base Exenta (0%)"      readonly="1"/>
                                    <field name="campo_443_base"   string="C.443 Base Reducida (8%)"    readonly="1"/>
                                    <field name="campo_453_debito" string="C.453 Débito Reducida (8%)"  readonly="1"/>
                                    <field name="campo_42_base"    string="C.42  Base General (16%)"    readonly="1"/>
                                    <field name="campo_42_debito"  string="C.43  Débito General (16%)"  readonly="1"/>
                                    <field name="campo_49"         string="C.49  Total Déb. Fiscal"     readonly="1"/>
                                </group>
                                <group string="Créditos Fiscales (Compras)">
                                    <field name="campo_33_base"    string="C.33  Base Compras"           readonly="1"/>
                                    <field name="campo_33_credito" string="C.34  Crédito Compras"        readonly="1"/>
                                    <field name="aplica_prorrata"  string="Prorrateo (Art. 34 LIVA)"
                                           readonly="estado == 'presentada'"/>
                                    <field name="porcentaje_prorrata"
                                           string="% Prorrata (ventas grav. / total)"
                                           invisible="not aplica_prorrata"
                                           readonly="estado == 'presentada'"/>
                                    <field name="campo_71"         string="C.71  Total Créd. Deducibles" readonly="1"/>
                                    <field name="campo_20"         string="C.20  Excedente Mes Anterior"
                                           readonly="estado == 'presentada'"/>
                                    <field name="campo_39"         string="C.39  Total Créditos"         readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <group string="Autoliquidación">
                                    <field name="campo_53" string="C.53  Total Cuota Tributaria" readonly="1"/>
                                    <field name="campo_60" string="C.60  Excedente Créd. (sig. período)" readonly="1"/>
                                    <field name="campo_78" string="C.78  Sub-total Impuesto a Pagar" readonly="1"/>
                                </group>
                                <group string="Retenciones Recibidas (Clientes SPE)">
                                    <field name="campo_54_arrastre" string="C.54  Retenciones Acum. por Descontar"
                                           readonly="estado == 'presentada'"/>
                                    <field name="campo_66"          string="C.66  Retenciones Período"   readonly="1"/>
                                    <field name="campo_74"          string="C.74  Total Retenciones"     readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <group string="Resultado">
                                    <field name="campo_90"              string="C.90  IVA a Pagar"         readonly="1"/>
                                    <field name="saldo_nuevo_campo_54"  string="Nuevo Saldo C.54"           readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- ── Tab 3: Declaración SENIAT ── -->
                        <page string="Declaración SENIAT" name="declaracion">
                            <group>
                                <group string="Declaración Forma 030">
                                    <field name="nro_declaracion"
                                           required="estado == 'presentada'"
                                           readonly="estado == 'presentada'"/>
                                    <field name="fecha_declaracion"
                                           required="estado == 'presentada'"
                                           readonly="estado == 'presentada'"/>
                                    <field name="declarado_por_id"  readonly="1"/>
                                    <field name="declarado_por_rpa" readonly="1"/>
                                    <field name="planilla_declaracion"
                                           widget="binary"
                                           string="Planilla SENIAT (PDF)"
                                           filename="planilla_declaracion_nombre"/>
                                    <field name="planilla_declaracion_nombre" invisible="1"/>
                                </group>
                                <group string="Sustitutiva" invisible="estado != 'sustitutiva'">
                                    <field name="declaracion_original_id" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══ Búsqueda ════════════════════════════════════════════════════════════ -->
    <record id="ve_declaracion_iva_view_search" model="ir.ui.view">
        <field name="name">ve.declaracion.iva.search</field>
        <field name="model">ve.declaracion.iva</field>
        <field name="arch" type="xml">
            <search string="Buscar Declaraciones IVA">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="periodo_retencion"/>
                <field name="nro_declaracion"/>
                <filter string="Borrador"   name="borrador"   domain="[('estado','=','borrador')]"/>
                <filter string="Presentada" name="presentada" domain="[('estado','=','presentada')]"/>
                <separator/>
                <filter string="Prov. Pendiente"  name="prov_pend"  domain="[('estado_prov','=','pendiente')]"/>
                <filter string="Prov. Declarado"  name="prov_decl"  domain="[('estado_prov','=','declarado')]"/>
                <group>
                    <filter string="Compañía" name="group_company"
                            context="{'group_by':'company_id'}"
                            groups="base.group_multi_company"/>
                    <filter string="Estado"          name="group_estado"    context="{'group_by':'estado'}"/>
                    <filter string="Estado Prov."    name="group_estado_prov" context="{'group_by':'estado_prov'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══ Acción principal ═════════════════════════════════════════════════════ -->
    <record id="ve_declaracion_iva_action" model="ir.actions.act_window">
        <field name="name">Declaración IVA</field>
        <field name="res_model">ve.declaracion.iva</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay declaraciones IVA registradas.
            </p>
            <p>Las declaraciones se crean automáticamente al crear un Período de Conciliación IVA.</p>
        </field>
    </record>

</odoo>
