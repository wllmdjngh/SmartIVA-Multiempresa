<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Formulario de facturas ── -->
    <record id="account_move_view_form_ve_retencion" model="ir.ui.view">
        <field name="name">account.move.form.ve.retencion</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">

            <!--
                En Odoo 19, el form de facturas usa <label for="invoice_date">
                separado del <field name="invoice_date">, y hay DOS labels
                con ese "for" en el mismo header_right_group sin contenedor
                propio: uno con string="Invoice Date" (out_invoice/out_refund)
                y otro con string="Bill Date" (in_invoice/in_refund), un
                xpath que matchee solo por @for cae en AMBOS y Odoo aplica la
                inserción en los 2 lugares, duplicando todo lo de abajo para
                Ventas (bug real encontrado 2026-09-04 por la usuaria, existía
                desde antes de esta sesión). NO se puede filtrar por @string
                (Odoo lo bloquea explícitamente: "View inheritance may not
                use attribute 'string' as a selector", rompió el registry
                completo en el primer intento). Se usa el índice de
                posición dentro de header_right_group en su lugar (el de
                Ventas es siempre el primero en el arch base).
            -->
            <xpath expr="//group[@id='header_right_group']/label[@for='invoice_date'][1]" position="before">
                <field name="nro_control"
                       string="N&#xB0; Control"
                       placeholder="00-0000000"
                       invisible="move_type not in ('out_invoice','out_refund')"/>
                <!--
                    nro_factura es un campo genérico a propósito (mapea
                    "Número de Factura" O "Nota de Crédito" O "Nota de
                    Débito", la que traiga la fila del Libro de Ventas,
                    ver _HEADER_MAP en ve_conecta_carga_ventas.py) para que
                    la lógica de duplicados/matching tenga un solo campo
                    que revisar sin importar el tipo de documento, se
                    sigue usando tal cual (no se muestra en la NC porque ya
                    repite el propio N&#xB0; de la NC, visible como t&#xED;tulo
                    del formulario).
                -->
                <field name="nro_factura"
                       string="N&#xB0; Factura"
                       invisible="move_type != 'out_invoice'"/>
                <!--
                    Datos de la FACTURA AFECTADA (no los propios de la NC),
                    pedido explícito de la usuaria 2026-09-04, related
                    read-only sobre reversed_entry_id, sin tocar nro_control/
                    nro_factura propios (esos siguen siendo el N&#xB0; real de
                    la NC, necesarios para duplicados/matching).
                -->
                <field name="factura_afectada_nro_control"
                       invisible="move_type != 'out_refund' or not reversed_entry_id"/>
                <field name="factura_afectada_nro_factura"
                       invisible="move_type != 'out_refund' or not reversed_entry_id"/>
                <field name="factura_afectada_fecha"
                       invisible="move_type != 'out_refund' or not reversed_entry_id"/>
            </xpath>

            <!--
                Vínculo NC <-> Factura, visible en ambos sentidos (Odoo core
                no lo expone para facturas/NC, solo para asientos, ver
                account_move.py action_view_notas_credito).
            -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" class="oe_stat_button" name="action_view_notas_credito"
                        icon="fa-usd"
                        invisible="move_type != 'out_invoice' or nota_credito_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="nota_credito_count"/></span>
                        <span class="o_stat_text">Notas de Crédito</span>
                    </div>
                </button>
                <button type="object" class="oe_stat_button" name="action_view_factura_afectada"
                        icon="fa-file-text-o"
                        invisible="move_type != 'out_refund' or not reversed_entry_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Factura Afectada</span>
                    </div>
                </button>
            </xpath>

            <!-- Pesta&#xF1;as de retenciones IVA -->
            <notebook position="inside">
                <page string="Retenciones IVA" name="ve_wh_iva"
                      invisible="move_type not in ('out_invoice','out_refund')">
                    <field name="ve_wh_iva_ids">
                        <list create="0" delete="0">
                            <field name="name"   string="N&#xB0; Comprobante"/>
                            <field name="estado_recepcion" string="Estado" widget="badge"
                                   decoration-muted="estado_recepcion == 'esperado'"
                                   decoration-info="estado_recepcion in ('recibido', 'recibido_dif')"
                                   decoration-success="estado_recepcion in ('confirmado', 'confirmado_dif')"
                                   decoration-warning="estado_recepcion == 'vencido'"
                                   decoration-danger="estado_recepcion == 'anulado'"/>
                            <field name="fecha"  string="Fecha Recibido"/>
                            <field name="monto_retenido"/>
                            <field name="porcentaje_retencion" string="% Ret."/>
                            <field name="canal_recepcion"/>
                            <button name="action_abrir_form" string="Abrir" type="object"
                                    icon="fa-external-link"
                                    class="btn-sm btn-link" title="Abrir comprobante"/>
                        </list>
                    </field>
                </page>
                <page string="Retenciones IVA Proveedores" name="ve_wh_iva_prov"
                      invisible="move_type not in ('in_invoice','in_refund')">
                    <field name="ve_wh_iva_prov_ids">
                        <list create="0" delete="0">
                            <field name="ref"          string="Ref."              style="max-width:120px;"/>
                            <field name="name"         string="N&#xB0; Comprobante"/>
                            <field name="state"        widget="badge"
                                   decoration-info="state == 'enviado'"
                                   decoration-success="state == 'declarado'"
                                   decoration-muted="state == 'anulado'"/>
                            <field name="fecha"        string="Fecha"/>
                            <field name="monto_retenido" string="Monto Retenido" sum="Total"/>
                            <field name="porcentaje_retencion" string="% Ret."/>
                            <button name="action_abrir_form" type="object"
                                    string="Abrir" icon="fa-external-link"
                                    class="btn-sm btn-link"/>
                        </list>
                    </field>
                </page>
            </notebook>

        </field>
    </record>

    <!-- ── N° Control en la vista lista de Facturas (Ventas y Compras) ── -->
    <record id="view_out_invoice_tree_ve_retencion" model="ir.ui.view">
        <field name="name">account.move.out.invoice.list.ve.retencion</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="nro_control" string="N&#xB0; Control" optional="show"/>
                <field name="nro_factura" string="N&#xB0; Factura" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_in_invoice_tree_ve_retencion" model="ir.ui.view">
        <field name="name">account.move.in.invoice.list.ve.retencion</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="nro_control" string="N&#xB0; Control" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
