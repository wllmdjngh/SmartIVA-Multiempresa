<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ ve.calendario.seniat — registro confirmado ══════════════════════ -->
    <record id="ve_calendario_seniat_view_form" model="ir.ui.view">
        <field name="name">ve.calendario.seniat.form</field>
        <field name="model">ve.calendario.seniat</field>
        <field name="arch" type="xml">
            <form string="Calendario SENIAT">
                <header>
                    <button name="action_confirmar" string="Confirmar"
                            type="object" class="btn-primary"
                            invisible="estado == 'confirmado'"/>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="anio"/>
                            <field name="providencia"/>
                        </group>
                        <group>
                            <field name="gaceta_oficial"/>
                            <field name="fecha_gaceta"/>
                        </group>
                    </group>
                    <group string="Archivo Fuente">
                        <field name="archivo" widget="binary" filename="archivo_nombre"/>
                        <field name="archivo_nombre" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Días Límite (240 filas)">
                            <field name="linea_ids">
                                <list editable="bottom">
                                    <field name="quincena"/>
                                    <field name="mes"/>
                                    <field name="rif_digito"/>
                                    <field name="dia_limite"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ve_calendario_seniat_view_list" model="ir.ui.view">
        <field name="name">ve.calendario.seniat.list</field>
        <field name="model">ve.calendario.seniat</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="anio"/>
                <field name="providencia"/>
                <field name="gaceta_oficial"/>
                <field name="fecha_gaceta"/>
                <field name="count_lineas" string="Filas"/>
                <field name="estado" widget="badge"
                       decoration-success="estado == 'confirmado'"
                       decoration-warning="estado == 'borrador'"/>
            </list>
        </field>
    </record>

    <record id="ve_calendario_seniat_action" model="ir.actions.act_window">
        <field name="name">Calendario SENIAT</field>
        <field name="res_model">ve.calendario.seniat</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ══ Calendario SENIAT por Empresa (vista SQL, solo lectura) ══════════ -->
    <record id="ve_calendario_seniat_por_empresa_view_list" model="ir.ui.view">
        <field name="name">ve.calendario.seniat.por.empresa.list</field>
        <field name="model">ve.calendario.seniat.por.empresa</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="company_id"/>
                <field name="rif"/>
                <field name="anio"/>
                <field name="quincena"/>
                <field name="mes_01"/>
                <field name="mes_02"/>
                <field name="mes_03"/>
                <field name="mes_04"/>
                <field name="mes_05"/>
                <field name="mes_06"/>
                <field name="mes_07"/>
                <field name="mes_08"/>
                <field name="mes_09"/>
                <field name="mes_10"/>
                <field name="mes_11"/>
                <field name="mes_12"/>
            </list>
        </field>
    </record>

    <record id="ve_calendario_seniat_por_empresa_view_search" model="ir.ui.view">
        <field name="name">ve.calendario.seniat.por.empresa.search</field>
        <field name="model">ve.calendario.seniat.por.empresa</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_id"/>
                <field name="rif"/>
                <field name="anio"/>
                <filter string="Empresa" name="group_empresa" context="{'group_by': 'company_id'}"/>
                <filter string="Año" name="group_anio" context="{'group_by': 'anio'}"/>
            </search>
        </field>
    </record>

    <record id="ve_calendario_seniat_por_empresa_action" model="ir.actions.act_window">
        <field name="name">Calendario SENIAT por Empresa</field>
        <field name="res_model">ve.calendario.seniat.por.empresa</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="ve_calendario_seniat_por_empresa_view_search"/>
    </record>

    <!-- ══ Wizard OCR de carga ══════════════════════════════════════════════ -->
    <record id="wizard_calendario_seniat_view_form" model="ir.ui.view">
        <field name="name">ve.calendario.seniat.wizard.form</field>
        <field name="model">ve.calendario.seniat.wizard</field>
        <field name="arch" type="xml">
            <form string="Cargar Calendario SENIAT">
                <field name="ocr_exitoso" invisible="1"/>

                <group string="Providencia Administrativa (PDF o Imagen)">
                    <field name="archivo" widget="binary" filename="archivo_nombre"/>
                    <field name="archivo_nombre" invisible="1"/>
                </group>

                <div class="text-center mb-2">
                    <button name="action_escanear"
                            string="Escanear con OCR (Claude Vision)"
                            type="object"
                            class="btn-primary"
                            icon="fa-search"
                            invisible="not archivo"/>
                </div>

                <div class="alert alert-warning mb-2" role="alert">
                    <i class="fa fa-exclamation-triangle" title="Atenci&#xF3;n"/> &#160;
                    <strong>Revise cada fila contra el documento original antes de confirmar</strong>
                    — es dato fiscal de vencimientos; un dígito mal leído por el OCR
                    puede marcar como "a tiempo" una declaración que en realidad venció.
                </div>

                <field name="texto_ocr" string="Detalle OCR" readonly="1"
                       invisible="not texto_ocr" widget="text"
                       style="font-size:9px; max-height:120px; overflow:auto;"/>

                <group string="Datos de la Providencia">
                    <group>
                        <field name="anio"/>
                        <field name="providencia"/>
                    </group>
                    <group>
                        <field name="gaceta_oficial"/>
                        <field name="fecha_gaceta"/>
                    </group>
                </group>

                <group string="Días Límite — editables, revise las 240 filas">
                    <field name="linea_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="quincena"/>
                            <field name="mes"/>
                            <field name="rif_digito"/>
                            <field name="dia_limite"/>
                        </list>
                    </field>
                </group>

                <footer>
                    <button name="action_confirmar" string="Confirmar Calendario"
                            type="object" class="btn-primary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_calendario_seniat_action" model="ir.actions.act_window">
        <field name="name">Cargar Calendario SENIAT</field>
        <field name="res_model">ve.calendario.seniat.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
