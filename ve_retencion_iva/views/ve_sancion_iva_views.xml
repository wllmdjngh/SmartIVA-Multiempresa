<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ Lista ══════════════════════════════════════════════════════════════ -->
    <record id="ve_sancion_iva_view_list" model="ir.ui.view">
        <field name="name">ve.sancion.iva.list</field>
        <field name="model">ve.sancion.iva</field>
        <field name="arch" type="xml">
            <list string="Sanciones IVA" decoration-danger="estado == 'pendiente'"
                  decoration-warning="estado == 'impugnada'"
                  decoration-muted="estado in ('pagada','prescrita')">
                <field name="name"/>
                <field name="numero_resolucion"/>
                <field name="fecha"/>
                <field name="tipo_origen"/>
                <field name="estado" widget="badge"
                       decoration-danger="estado == 'pendiente'"
                       decoration-warning="estado == 'impugnada'"
                       decoration-success="estado == 'pagada'"
                       decoration-muted="estado == 'prescrita'"/>
                <field name="monto_total_bs" string="Total (Bs)" sum="Total Bs"/>
                <field name="monto_total_eur" string="Total (EUR)" sum="Total EUR"/>
                <field name="fecha_prescripcion" string="Prescripci&#xf3;n" optional="show"/>
                <field name="fecha_vencimiento_pago" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ══ Formulario ═════════════════════════════════════════════════════════ -->
    <record id="ve_sancion_iva_view_form" model="ir.ui.view">
        <field name="name">ve.sancion.iva.form</field>
        <field name="model">ve.sancion.iva</field>
        <field name="arch" type="xml">
            <form string="Sanci&#xf3;n IVA Venezuela">

                <header>
                    <field name="estado" widget="statusbar"
                           statusbar_visible="pendiente,impugnada,pagada"/>
                </header>

                <sheet>

                    <!-- Stat button: total EUR (solo informativo) -->
                    <div class="oe_button_box" name="button_box">
                        <div class="oe_stat_button" icon="fa-eur">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="monto_total_eur" widget="float"
                                           options="{'digits': [16,2]}" readonly="1"/>
                                </span>
                                <span class="o_stat_text">EUR Total</span>
                            </div>
                        </div>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Descripci&#xf3;n de la sanci&#xf3;n"/></h1>
                    </div>

                    <group>
                        <group string="Identificaci&#xf3;n">
                            <field name="numero_resolucion"
                                   placeholder="SNAT/2026/XXXX"/>
                            <field name="fecha"/>
                            <field name="tipo_origen"/>
                        </group>
                        <group string="Prescripci&#xf3;n y Pago">
                            <field name="es_agente_retencion"/>
                            <field name="fecha_prescripcion" readonly="1"/>
                            <field name="fecha_vencimiento_pago"/>
                            <field name="fecha_pago"
                                   invisible="estado != 'pagada'"/>
                        </group>
                    </group>

                    <!-- Totales -->
                    <group>
                        <group string="Totales">
                            <field name="monto_total_bs" readonly="1" string="Total (Bs)"/>
                            <field name="monto_total_eur" readonly="1" string="Total (EUR)"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="L&#xed;neas de Detalle" name="lineas">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="periodo_id" string="Per&#xed;odo"/>
                                    <field name="periodo_desc"
                                           invisible="periodo_id != False"
                                           placeholder="ej. 2025 1Q"/>
                                    <field name="tipo"/>
                                    <field name="descripcion" placeholder="Concepto detallado"/>
                                    <field name="cantidad"/>
                                    <field name="monto_bs" string="Monto Bs (resoluci&#xf3;n)" sum="Total Bs"/>
                                    <field name="tasa_eur_bcv" string="Tasa EUR"/>
                                    <field name="monto_eur" string="Monto (EUR)"
                                           readonly="1" sum="Total EUR"/>
                                    <field name="monto_bs_hoy" string="Monto Bs (hoy)"
                                           readonly="1" optional="show" sum="Total Bs hoy"/>
                                </list>
                            </field>
                        </page>
                        <page string="Retenciones Vinculadas" name="retenciones">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="periodo_desc"/>
                                    <field name="tipo"/>
                                    <field name="wh_iva_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                            <p class="text-muted small">
                                Las retenciones vinculadas se asignan en cada l&#xed;nea
                                de detalle (campo "Retenciones Vinculadas").
                            </p>
                        </page>
                        <page string="Notas" name="notas">
                            <field name="note" placeholder="Fundamento legal, recurso presentado, observaciones..."/>
                        </page>
                    </notebook>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══ Búsqueda ═══════════════════════════════════════════════════════════ -->
    <record id="ve_sancion_iva_view_search" model="ir.ui.view">
        <field name="name">ve.sancion.iva.search</field>
        <field name="model">ve.sancion.iva</field>
        <field name="arch" type="xml">
            <search string="Sanciones IVA">
                <field name="name"/>
                <field name="numero_resolucion"/>
                <filter string="Pendientes" name="pendiente"
                        domain="[('estado','=','pendiente')]"/>
                <filter string="Impugnadas" name="impugnada"
                        domain="[('estado','=','impugnada')]"/>
                <filter string="Pagadas" name="pagada"
                        domain="[('estado','=','pagada')]"/>
                <separator/>
                <filter string="A&#xf1;o Actual" name="anio_actual"
                        domain="[('fecha','&gt;=', time.strftime('%Y-01-01'))]"/>
                <group>
                    <filter string="Estado" name="grp_estado" context="{'group_by': 'estado'}"/>
                    <filter string="Tipo Origen" name="grp_tipo" context="{'group_by': 'tipo_origen'}"/>
                    <filter string="A&#xf1;o" name="grp_anio" context="{'group_by': 'fecha:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══ Acción ══════════════════════════════════════════════════════════════ -->
    <record id="ve_sancion_iva_action" model="ir.actions.act_window">
        <field name="name">Sanciones IVA</field>
        <field name="res_model">ve.sancion.iva</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ve_sancion_iva_view_search"/>
        <field name="context">{'search_default_pendiente': 1}</field>
    </record>

</odoo>
