<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wizard_subir_comprobante_view_form" model="ir.ui.view">
        <field name="name">ve.wh.iva.wizard.comprobante.form</field>
        <field name="model">ve.wh.iva.wizard.comprobante</field>
        <field name="arch" type="xml">
            <form string="Adjuntar Comprobante de Retenci&#xF3;n IVA">

                <field name="wh_iva_id"            invisible="1"/>
                <field name="cliente_no_encontrado" invisible="1"/>
                <field name="ocr_exitoso"           invisible="1"/>
                <field name="tiene_comprobante"     invisible="1"/>

                <!-- Advertencia cuando ya existe un comprobante -->
                <div class="alert alert-warning mb-0"
                     role="alert"
                     invisible="not tiene_comprobante">
                    <strong>&#x26A0; Este registro ya tiene un comprobante.</strong>
                    Al guardar se reemplazarán los datos de identificación actuales.
                    <br/>
                    <field name="confirmar_reemplazo" class="mt-2"/>
                    <label for="confirmar_reemplazo"/>
                </div>

                <!-- Validaci&#xF3;n: el RIF y N° Factura del comprobante deben coincidir
                     con los de la retención esperada. Si no coinciden, la acción
                     "Guardar" lanza un UserError y NO actualiza nada. -->

                <group string="Archivo del Comprobante">
                    <field name="archivo" widget="binary" filename="archivo_nombre"
                           string="PDF / Imagen"/>
                    <field name="archivo_nombre" invisible="1"/>
                </group>

                <div class="text-center mb-2">
                    <button name="action_escanear"
                            string="Escanear con OCR (Claude Vision)"
                            type="object"
                            class="btn-primary"
                            icon="fa-search"
                            invisible="not archivo"/>
                </div>

                <!-- Resultado OCR -->
                <div class="alert alert-success mb-2" role="alert"
                     invisible="not ocr_exitoso">
                    <i class="fa fa-check-circle" title="Correcto"/> &#160;
                    <strong>OCR exitoso</strong> — revisa y corrige los datos si es necesario.
                </div>
                <field name="texto_ocr" string="Texto extra&#xED;do (OCR)"
                       readonly="1"
                       invisible="not texto_ocr"
                       widget="text"
                       style="font-size:9px; max-height:80px; overflow:auto;"/>

                <group string="Datos del Comprobante">
                    <group>
                        <field name="ocr_name"          string="N&#xB0; Comprobante"
                               placeholder="14 d&#xED;gitos"/>
                        <field name="ocr_fecha_doc"     string="Fecha Comprobante"/>
                        <field name="ocr_tipo_documento" string="Tipo de Transacci&#xF3;n"/>
                    </group>
                    <group>
                        <!-- Campos de validaci&#xF3;n: deben coincidir con la retenci&#xF3;n -->
                        <field name="ocr_rif_agente"    string="RIF Agente Retenedor"
                               placeholder="J-00000000-0  (se valida vs. cliente)"/>
                        <field name="ocr_nro_documento" string="N&#xB0; Factura"
                               placeholder="n&#xFA;mero de la factura (se valida vs. retenci&#xF3;n)"/>
                        <field name="ocr_nro_control"   string="N&#xB0; Control"
                               placeholder="00-XXXXXXX"/>
                    </group>
                    <group>
                        <field name="ocr_monto_base"      string="Base Imponible"/>
                        <field name="ocr_monto_iva"        string="Impuesto IVA"/>
                        <field name="ocr_alicuota"         string="Al&#xED;cuota %"/>
                        <field name="ocr_monto_retenido"   string="IVA Retenido (comprobante)"/>
                    </group>
                </group>

                <div class="alert alert-info" role="alert" style="font-size:8pt; margin:4px 0;">
                    <strong>Validaci&#xF3;n:</strong>
                    El RIF del agente y el N° Control deben coincidir con la retenci&#xF3;n esperada.
                    Si el RIF o N° Control no coinciden, el sistema alerta y no guarda nada.
                </div>

                <footer>
                    <button name="action_guardar"
                            string="Guardar"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
