<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wizard_conciliacion_libro_ventas_view_form" model="ir.ui.view">
        <field name="name">ve.conciliacion.libro.ventas.wizard.form</field>
        <field name="model">ve.conciliacion.libro.ventas.wizard</field>
        <field name="arch" type="xml">
            <form string="Conciliación Libro de Ventas vs SmartIVA">
                <div class="alert alert-info" role="alert">
                    Genera un Excel comparando el Libro de Ventas del cliente (tal cual se
                    cargó en "Cargar Libro de Ventas (Conecta)") contra lo que SmartIVA
                    calculó -- Resumen (por Contribuyente, Validación de carga, motivos de
                    diferencia, Retenido con/sin Comprobante, Por mes) + una pestaña de
                    detalle por quincena + Consolidado. No hace falta volver a subir ningún
                    archivo -- usa los datos ya cargados en Odoo.
                </div>
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="fecha_desde"/>
                    <field name="fecha_hasta"/>
                </group>
                <footer>
                    <button name="action_generar" string="Generar Excel" type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_conciliacion_libro_ventas_action" model="ir.actions.act_window">
        <field name="name">Conciliación Libro de Ventas vs SmartIVA</field>
        <field name="res_model">ve.conciliacion.libro.ventas.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
