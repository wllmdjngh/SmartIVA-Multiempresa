<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wizard_crear_periodo_view_form" model="ir.ui.view">
        <field name="name">ve.periodo.wizard.crear.form</field>
        <field name="model">ve.periodo.wizard.crear</field>
        <field name="arch" type="xml">
            <form string="Nuevo Período de Conciliación SENIAT">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="anio"/>
                    <field name="mes"/>
                    <field name="quincena"/>
                </group>
                <footer>
                    <button name="action_crear" string="Crear" type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_crear_periodo_action" model="ir.actions.act_window">
        <field name="name">Nuevo Período</field>
        <field name="res_model">ve.periodo.wizard.crear</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
