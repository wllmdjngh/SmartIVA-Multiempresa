<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Aparece en el menú Acciones de la vista lista de Monedas.
        Al ejecutar, actualiza USD y EUR independientemente de cuáles
        estén seleccionadas.
    -->
    <record id="action_server_update_bcv_rates" model="ir.actions.server">
        <field name="name">Actualizar tasas BCV (USD/EUR)</field>
        <field name="model_id" ref="base.model_res_currency"/>
        <field name="binding_model_id" ref="base.model_res_currency"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = model.action_update_bcv_rates(manual=True)</field>
    </record>
</odoo>
