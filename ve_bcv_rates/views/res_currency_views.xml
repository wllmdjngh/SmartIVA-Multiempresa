<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_currency_form_bcv" model="ir.ui.view">
        <field name="name">res.currency.form.bcv</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_update_bcv_rates_manual"
                            string="Actualizar tasas BCV"
                            type="object"
                            class="btn-primary"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
